# Separate QEMU profile; does not modify approved UML fragments.
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_IO_APIC=y
CONFIG_X86_MPPARSE=y
CONFIG_ACPI=y
CONFIG_KUNIT=y
CONFIG_KUNIT_ALL_TESTS=n
CONFIG_GX_OFFLINE_KUNIT_TEST=y
CONFIG_DEBUG_KERNEL=y
CONFIG_HAVE_ARCH_KCSAN=y
CONFIG_HAVE_KCSAN_COMPILER=y
CONFIG_KCSAN=y
CONFIG_KCSAN_STRICT=y
CONFIG_KCSAN_SELFTEST=y
CONFIG_KCSAN_KUNIT_TEST=n
CONFIG_KASAN=n
CONFIG_MODULES=n
CONFIG_WERROR=n
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=n
CONFIG_LOCALVERSION="-gx-v07-kcsan"
CONFIG_LOCALVERSION_AUTO=n
